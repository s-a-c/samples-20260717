{
    "name": "laravel/livewire-starter-kit",
    "description": "The official Laravel starter kit for Livewire.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.5",
        "asmit/resized-column": "^3.0.2",
        "awcodes/filament-badgeable-column": "^4.2",
        "awcodes/filament-curator": "^5.1.4",
        "bezhansalleh/filament-panel-switch": "^3.1",
        "bezhansalleh/filament-shield": "^4.3.1",
        "filament/spatie-laravel-tags-plugin": "^5.7.3",
        "lara-zeus/activity-timeline": "^5.0.3",
        "laravel-chronicle/core": "^1.13",
        "laravel/ai": "^0.10.1",
        "laravel/chisel": "^0.1.1",
        "laravel/fortify": "^1.37.3",
        "laravel/framework": "^13.22.0",
        "laravel/horizon": "^5.48.1",
        "laravel/pulse": "^1.7.4",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3.3",
        "laravel/telescope": "^5.21",
        "laravel/tinker": "^3.0.2",
        "livewire/blaze": "^1.0.12",
        "livewire/flux": "^2.15.0",
        "livewire/flux-pro": "^2.15",
        "livewire/livewire": "^4.3.3",
        "nunomaduro/essentials": "^1.2",
        "relaticle/flowforge": "^4.0.14",
        "shuvroroy/filament-spatie-laravel-backup": "^3.4",
        "shuvroroy/filament-spatie-laravel-health": "^3.3.1",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-horizon-watcher": "^1.2",
        "stechstudio/filament-impersonate": "^5.6",
        "tpetry/laravel-postgresql-enhanced": "^3.7"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "carthage-software/mago": "^1.45",
        "driftingly/rector-laravel": "^2.5",
        "ergebnis/composer-normalize": "^2.52",
        "ergebnis/rector-rules": "^1.18.3",
        "fakerphp/faker": "^1.24.1",
        "filament/blueprint": "^2.2.0",
        "fruitcake/laravel-debugbar": "^4.4.0",
        "jasonmccreary/laravel-test-assertions": "^2.9",
        "joshcirre/instruckt-laravel": "^0.4.29",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.4.13",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.2",
        "laravel/pint": "^1.29.3",
        "laravel/sail": "^1.64",
        "laraveldaily/filacheck-pro": "^1.2.7",
        "mockery/mockery": "^1.6.12",
        "mrpunyapal/peststan": "^0.2.12",
        "mrpunyapal/rector-pest": "^0.2.17",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^4.7.5",
        "pestphp/pest-plugin-arch": "^4.0.2",
        "pestphp/pest-plugin-drift": "^4.1",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "pestphp/pest-plugin-mutate": "^4.0.1",
        "pestphp/pest-plugin-profanity": "^4.2.1",
        "pestphp/pest-plugin-type-coverage": "^4.0.4",
        "php-parallel-lint/php-console-color": "^1.0.1",
        "php-parallel-lint/php-console-highlighter": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.5",
        "phpstan/phpstan-deprecation-rules": "^2.0.4",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.5.7",
        "rector/swiss-knife": "^2.4.8",
        "rector/type-perfect": "^2.1.4",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ray": "^1.43.9",
        "spatie/laravel-web-tinker": "^1.10.6",
        "spatie/pest-plugin-snapshots": "^2.3.1"
    },
    "repositories": [
        {
            "name": "flux-pro",
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        },
        {
            "name": "filacheck",
            "type": "composer",
            "url": "https://satis.filamentexamples.com"
        },
        {
            "name": "laravel-comments",
            "type": "composer",
            "url": "https://satis.spatie.be"
        },
        {
            "name": "filament-blueprint",
            "type": "composer",
            "url": "https://packages.filamentphp.com/composer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "analyze": [
            "@lint:check",
            "@types:check",
            "@filacheck",
            "@mago:analyze",
            "@types-check"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "filacheck": "vendor/bin/filacheck --detailed --dry-run",
        "filacheck:fix": "vendor/bin/filacheck --detailed --fix --backup",
        "lint": [
            "pint --parallel",
            "vendor/bin/phpstan analyse --memory-limit=512M",
            "@test:mago"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "mago:analyze": "vendor/bin/mago analyze",
        "mago:analyze:fix": "vendor/bin/mago analyze --fix",
        "mago:guard": "vendor/bin/mago guard",
        "rector": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process",
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force",
            "pnpm install --frozen-lockfile",
            "pnpm run build"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "test:arch": [
            "@mago:guard",
            "php artisan test --testsuite=Architecture"
        ],
        "test:coverage": "php artisan test --coverage --min=80 --coverage-html=storage/coverage",
        "test:feature": "php artisan test --testsuite=Feature",
        "test:livewire": "php artisan test --filter=Livewire",
        "test:pg": "php artisan test tests/Feature/Postgres",
        "test:type-cov": "vendor/bin/pest --type-coverage --min=100 --compact --coverage-html=storage/coverage",
        "test:unit": "php artisan test --testsuite=Unit",
        "types:check": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "update:requirements": [
            "composer update -oW",
            "composer normalize",
            "composer bump",
            "composer update -oW",
            "pnpm pkg fix",
            "pnpm dlx sort-package-json",
            "pnpm dlx npm-check-updates -u",
            "pnpm update"
        ]
    },
    "$schema": "https://getcomposer.org/schema.json"
}
