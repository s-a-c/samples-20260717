# .envrc — direnv loader for samples-20260717 SAGE integration.
#
# Infisical is the source of truth for the project identity; .env.sage is an
# untracked cache, hydrated from Infisical and used as offline fallback.
# direnv restores the previous (home) SAGE_* values on cd out of the repo,
# making the env var the namespace switch: project/samples-20260717 in,
# workspace/home out.
#
# v11 model: ONE shared SAGE token (node-operator-scoped). direnv re-exports
# the same bearer under each host's expected env-var name so all 7 hosts
# (OpenCode, Codex, Claude Code, Cursor, Zed, Junie, Copilot) scope correctly.

# Inherit parent (home) environment — GH_TOKEN, INFISICAL_DOMAIN, etc.
source_up

INFISICAL_DOMAIN="${INFISICAL_DOMAIN:-https://infisical.stands-macbook-pro.local/api}"
# Project-scoped token — constrains the fetch to samples-20260717's secrets only.
# (A workspace service token would dump the whole workspace; --projectId cannot
# narrow it. The token enforces scope.)
SAMPLES_INFISICAL_TOKEN_FILE="${SAMPLES_INFISICAL_TOKEN_FILE:-$HOME/.config/infisical/samples-20260717-token}"

_infetched=""
if [[ -s "$SAMPLES_INFISICAL_TOKEN_FILE" ]] && command -v infisical >/dev/null 2>&1; then
  _ctoken="$(<"$SAMPLES_INFISICAL_TOKEN_FILE")"
  # Fetch ONLY samples-20260717's secrets (the project-scoped token enforces this).
  # Redirect 2>/dev/null so a server-offline condition falls through to the
  # cache rather than aborting the shell.
  _infetched="$(infisical export --format=dotenv-export --env=dev \
    --domain="$INFISICAL_DOMAIN" --token="$_ctoken" 2>/dev/null)" || _infetched=""
  unset _ctoken
fi

if [[ -n "$_infetched" ]]; then
  # Online: hydrate the cache from Infisical, then source it.
  umask 077
  printf '%s\n' "$_infetched" > .env.sage
  # shellcheck source=/dev/null
  source .env.sage
elif [[ -f .env.sage ]]; then
  # Offline fallback: use the existing cache (may be stale).
  # shellcheck source=/dev/null
  source .env.sage
fi
unset _infetched

# Re-export under each host's expected name. ONE shared token, 4 naming schemes.
# Fail-closed if nothing loaded (bearer empty → sage 401, correct).
if [[ -n "${SAMPLES_SAGE_MCP_BEARER_TOKEN:-}" ]]; then
  # OpenCode (reads SAGE_OPENCODE_*)
  export SAGE_OPENCODE_MCP_BEARER_TOKEN="${SAMPLES_SAGE_MCP_BEARER_TOKEN}"
  export SAGE_OPENCODE_MCP_TOKEN_ID="${SAMPLES_SAGE_MCP_TOKEN_ID}"
  export SAGE_OPENCODE_MCP_AGENT_ID="${SAMPLES_SAGE_MCP_AGENT_ID}"
  # Codex (reads SAGE_CODEX_*)
  export SAGE_CODEX_MCP_BEARER_TOKEN="${SAMPLES_SAGE_MCP_BEARER_TOKEN}"
  export SAGE_CODEX_MCP_TOKEN_ID="${SAMPLES_SAGE_MCP_TOKEN_ID}"
  export SAGE_CODEX_MCP_AGENT_ID="${SAMPLES_SAGE_MCP_AGENT_ID}"
  # Claude Code (reads SAGE_CLAUDE_*)
  export SAGE_CLAUDE_MCP_BEARER_TOKEN="${SAMPLES_SAGE_MCP_BEARER_TOKEN}"
  export SAGE_CLAUDE_MCP_TOKEN_ID="${SAMPLES_SAGE_MCP_TOKEN_ID}"
  export SAGE_CLAUDE_MCP_AGENT_ID="${SAMPLES_SAGE_MCP_AGENT_ID}"
  # Unprefixed (Cursor, Zed, Junie, Copilot, and verify-sage.sh)
  export SAGE_MCP_BEARER_TOKEN="${SAMPLES_SAGE_MCP_BEARER_TOKEN}"
  export SAGE_MCP_TOKEN_ID="${SAMPLES_SAGE_MCP_TOKEN_ID}"
  export SAGE_MCP_AGENT_ID="${SAMPLES_SAGE_MCP_AGENT_ID}"
  # Shared context
  export SAGE_URL="${SAMPLES_SAGE_URL:-https://sage.stands-macbook-pro.local}"
  export SAGE_MCP_HEALTH_URL="${SAMPLES_SAGE_MCP_HEALTH_URL:-http://127.0.0.1:7243/health}"
  export SAGE_WORKSPACE_ID="${SAMPLES_SAGE_WORKSPACE_ID:-samples-20260717}"
fi

# Siyuan PKM integration (direct HTTP, no MCP server).
# Global API token — discipline-based isolation: AGENTS.md constrains the agent
# to the samples-20260717 notebook. The token is technically admin over the
# whole instance; do not touch other notebooks (e.g. Control Plane Golden Path).
if [[ -n "${SAMPLES_SIYUAN_API_TOKEN:-}" ]]; then
  export SAMPLES_SIYUAN_API_TOKEN
  export SAMPLES_SIYUAN_NOTEBOOK_ID
  export SAMPLES_SIYUAN_NOTEBOOK_NAME
  export SAMPLES_SIYUAN_API_URL="${SAMPLES_SIYUAN_API_URL:-http://127.0.0.1:6806}"
  export SAMPLES_SIYUAN_NAMED_URL="${SAMPLES_SIYUAN_NAMED_URL:-https://siyuan.stands-macbook-pro.local:7244}"
  export SAMPLES_SIYUAN_HEALTH_URL="${SAMPLES_SIYUAN_HEALTH_URL:-http://127.0.0.1:6806/api/system/version}"
fi
