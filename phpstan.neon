includes:
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: max

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: staticMethod.dynamicCall
            # framework-idiom: Eloquent query builder uses dynamic calls to static
            # methods (where, exists, first, when, etc.) by design. This strict-rules
            # identifier is structurally incompatible with Laravel's ORM and cannot
            # be fixed in code. Permanent carve-out per bd .eac5a270.2 resolution;
            # reviewed on framework or PHPStan major version bump.

        -
            identifier: missingType.generics
            # framework-idiom: Eloquent relation return types (HasMany, BelongsTo,
            # BelongsToMany, etc.) are generic classes in Larastan stubs but model
            # code does not specify generic parameters — adding @extends annotations
            # to every relation would be excessively verbose and is not idiomatic.
            # Reviewed on Larastan or PHPStan major version bump.

        -
            identifier: method.nonObject
            paths:
                - tests/*
            # framework-idiom: PHPStan strict-rules fires when a method is called on a
            # `mixed` receiver. Pest feature tests routinely operate on mixed values
            # (factory output, $response->json, Eloquent relations loaded via Refresh-
            # Database, Filament Livewire form state). Typing every receiver in test
            # code is not idiomatic and adds no signal. Scoped to tests/* so app-code
            # mixed receivers stay strict. Wayfinder #15 G1; revisit on Pest/Larastan
            # major version bump.

        -
            identifier: property.nonObject
            paths:
                - tests/*
            # framework-idiom: same rationale as method.nonObject above — property
            # access on mixed in Pest test code. Scoped to tests/*. Wayfinder #15 G1.

        -
            identifier: method.notFound
            paths:
                - tests/*
            # framework-idiom: Pest/Laravel and Livewire test helpers are dynamically
            # mixed into the bound test case; PHPStan's Pest stubs model the receiver
            # as TestCall and report framework methods as missing. Scoped to tests;
            # application method-not-found errors remain strict. Revisit on Pest/Larastan
            # major version bump. Task .18 / GitHub #106.

        -
            identifier: property.notFound
            paths:
                - tests/*
            # framework-idiom: the same Pest/Laravel test-case receiver limitation as
            # method.notFound. Scoped to tests only. Task .18 / GitHub #106.

        -
            identifier: method.deprecated
            paths:
                - app/Filament/*
            # framework-idiom: Filament v5 deprecation wave — Tables\Table::actions()
            # is deprecated in favour of recordActions() across the generated Pagila
            # resources. These are framework-driven deprecations during the v5 adoption
            # window, not application bugs. Phase B (wayfinder #15 G1 ratchet) migrates
            # each resource to recordActions(); this carve-out is removed once the last
            # one is fixed. Scoped to app/Filament/*.

        -
            identifier: typeCoverage.paramTypeCoverage
            # aspirational metric: phpstan strict-rules reports the global % of params
            # carrying a type hint (threshold 99%). The project is below that threshold
            # across many files. Baselining this per-file is inherently fragile — every
            # typed-param added/removed anywhere shifts ALL counts. Tracked as a project
            # quality metric (ratchet toward 99%), not per-ticket debt. Wayfinder #15 G1.

        -
            identifier: typeCoverage.constantTypeCoverage
            # aspirational metric: same rationale as typeCoverage.paramTypeCoverage for
            # constant types. Wayfinder #15 G1.

        -
            message: '#^Method App\\Livewire\\Actions\\Logout::__invoke\(\) never returns Livewire\\Features\\SupportRedirects\\Redirector so it can be removed from the return type\.$#'
            identifier: return.unusedType
            path: app/Livewire/Actions/Logout.php
            # framework-idiom (verified false positive): within a Livewire request
            # Livewire dynamically rebinds the `redirect()` helper to return its own
            # Redirector, so the union `Redirector|RedirectResponse` return type is
            # correct at runtime. phpstan cannot see the dynamic binding; following its
            # advice (drop Redirector) breaks the delete-account redirect flow
            # (tests/Feature/Settings/ProfileUpdateTest). Re-evaluate on Livewire major
            # version bump. Wayfinder #15 G2.


