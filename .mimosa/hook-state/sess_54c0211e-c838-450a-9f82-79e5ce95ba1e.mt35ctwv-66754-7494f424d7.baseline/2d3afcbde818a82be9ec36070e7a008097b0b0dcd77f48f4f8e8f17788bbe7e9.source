            <h4 class="text-sm font-semibold text-gray-900 dark:text-white p-3"
                <?php if($hasCardAction && $cardAction): ?>
                    wire:click="mountAction('<?php echo e($cardAction); ?>', [], <?php echo \Illuminate\Support\Js::from(['recordKey' => $record['id']])->toHtml() ?>)"
                style="cursor: pointer;"
                <?php endif; ?>
            >
                <?php echo e($record['title']); ?>

