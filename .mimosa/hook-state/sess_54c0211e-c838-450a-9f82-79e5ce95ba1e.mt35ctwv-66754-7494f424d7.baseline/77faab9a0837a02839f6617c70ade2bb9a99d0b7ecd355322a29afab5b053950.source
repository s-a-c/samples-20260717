# ---- helper for multi-class mapper files ----
def add_mapper_file(path, file_summary, file_tags, primary_cls, primary_lr, primary_methods,
                    subclasses, imports, inherits_map, calls_targets):
    """
    subclasses: list of dicts {name, lr, summary, tags, cx, parent (TM/SRM/PM_BASE),
                               methods: [(name, lr, summary, tags, cx)]}
    imports: list of file paths
    inherits_map: list of (class_node_id_in_this_file, parent_node_id)  -- but we build ids here
    calls_targets: list of (primary_load_func_id, target_func_id)
    """
    fid = f"file:{path}"
    add_node({"id": fid, "type": "file", "name": path.split("/")[-1], "filePath": path,
              "summary": file_summary, "tags": file_tags, "complexity": "complex"})
    # primary class
    pid = f"class:{path}:{primary_cls}"
    add_node({"id": pid, "type": "class", "name": primary_cls, "filePath": path,
              "summary": primary_methods["class_summary"], "tags": primary_methods["class_tags"],
              "complexity": "moderate", "lineRange": primary_lr})
    add_edge(fid, pid, "contains", 1.0)
    for mname, lr, summ, tags, cx in primary_methods["methods"]:
        mid = f"function:{path}:{primary_cls}::{mname}"
        add_node({"id": mid, "type": "function", "name": mname, "filePath": path,
                  "summary": summ, "tags": tags, "complexity": cx, "lineRange": lr})
        add_edge(fid, mid, "contains", 1.0)
    add_edge(fid, pid, "exports", 0.8)
    add_edge(pid, PM_BASE, "inherits", 0.9)
    # subclasses
    for sc in subclasses:
        scid = f"class:{path}:{sc['name']}"
        add_node({"id": scid, "type": "class", "name": sc["name"], "filePath": path,
                  "summary": sc["summary"], "tags": sc["tags"],
                  "complexity": sc["cx"], "lineRange": sc["lr"]})
        add_edge(fid, scid, "contains", 1.0)
        for (mname, lr, summ, tags, cx) in sc["methods"]:
            mid = f"function:{path}:{sc['name']}::{mname}"
            add_node({"id": mid, "type": "function", "name": mname, "filePath": path,
                      "summary": summ, "tags": tags, "complexity": cx, "lineRange": lr})
            add_edge(fid, mid, "contains", 1.0)
        add_edge(scid, sc["parent"], "inherits", 0.9)
    # imports
    for tgt in imports:
        add_edge(fid, f"file:{tgt}", "imports", 0.7)
    # calls from primary load to each subclass load
    primary_load_id = f"function:{path}:{primary_cls}::load"
    for tgt_func_id in calls_targets:
        add_edge(primary_load_id, tgt_func_id, "calls", 0.8)

