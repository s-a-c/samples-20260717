]
def ctor(lr):
    return list(CTOR_SIMPLE[:2]) if False else (CTOR_SIMPLE[0], lr, CTOR_SIMPLE[2], CTOR_SIMPLE[3], CTOR_SIMPLE[4])
chinook_sub_dicts = []
for name, lr, summ, tags, cx, parent, meths in chinook_subs:
    ctor_lr = lr[0] + 2  # __construct is 2 lines below class start (matches structure)
    methods = [ctor((lr[0]+2, lr[0]+4))] + meths
    chinook_sub_dicts.append({"name": name, "lr": lr, "summary": summ, "tags": tags, "cx": cx, "parent": parent, "methods": methods})
