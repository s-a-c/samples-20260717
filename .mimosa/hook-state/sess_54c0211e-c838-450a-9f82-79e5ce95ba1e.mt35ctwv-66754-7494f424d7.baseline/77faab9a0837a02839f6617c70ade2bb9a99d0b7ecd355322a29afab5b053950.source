def staging_path(product, cls):
    return f"app/Domain/Staging/{product}/{cls}.php"

def add_staging_file(product, cls, entity, table):
    p = staging_path(product, cls)
    fid = f"file:{p}"
    cid = f"class:{p}:{cls}"
    add_node({
        "id": fid, "type": "file", "name": f"{cls}.php", "filePath": p,
        "summary": f"Final staging Eloquent model for the {product} {entity} entity, targeting `{table}`; mass-assignment open ($guarded = []) for import-only writes during a ResetRun.",
        "tags": ["staging-model", product.lower(), entity, "eloquent", "import"],
        "complexity": "simple",
    })
    add_node({
        "id": cid, "type": "class", "name": cls, "filePath": p,
        "summary": f"Final staging model extending StagingModel, mapped to `{table}` via the Illuminate Table attribute.",
        "tags": ["staging-model", product.lower(), entity],
        "complexity": "simple",
        "lineRange": [10, 11],
    })
    add_edge(fid, cid, "contains", 1.0)
    add_edge(fid, cid, "exports", 0.8)
    add_edge(fid, "file:app/Domain/Staging/StagingModel.php", "imports", 0.7)
    add_edge(cid, "class:app/Domain/Staging/StagingModel.php:StagingModel", "inherits", 0.9)

